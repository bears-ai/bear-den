{% extends "bear/_manage.html" %}
{% block title %}Hats · {{ bear.slug }}{% endblock %}
{% block manage %}
<div class="box">
  <h2>Hats</h2>
  <details><summary>Responsibility, knowledge and access</summary>
  <p class="form-hint">A hat names a responsibility and limits which of this Bear's assigned work surfaces it may use. It does not grant a tool, credential, or permission. Conversation notes stay private unless Curate publishes a newly written fact for their hat. Shared hat knowledge can be used by every authorized wearer, including eligible Job runs.</p>
  <p class="form-hint">IDE default: {% if ide_default_hat_id %}the marked hat below{% else %}none selected{% endif %}. New IDE conversations wear this hat unless the human selects another with /hat before the first interaction. Existing conversations and Jobs do not change. With no IDE default, new IDE conversations remain unbound until /hat is selected.</p>
  </details>
  {% if hats %}
  <ul>
    {% for hat in hats %}
    <li><a href="/bear/{{ bear.slug | e }}/hats/{{ hat.id }}">{{ hat.name | e }}</a> — {% if hat.short_summary %}{{ hat.short_summary | e }}{% else %}Short summary not set{% endif %} · automatic memory sharing {{ hat.auto_curate_enabled and "on" or "off" }} · Job use {{ hat.work_enabled and "on" or "off" }}
      {% if hat.id == ide_default_hat_id %}<strong>· IDE default</strong>{% else %}
      <form method="post" action="/bear/{{ bear.slug | e }}/hats/{{ hat.id }}/ide-default"><button type="submit">Make IDE default</button></form>
      {% endif %}
    </li>
    {% endfor %}
  </ul>
  {% else %}<p>No hats configured yet.</p>{% endif %}
</div>
<div class="box">
  <h3>New hat</h3>
  <form method="post" action="/bear/{{ bear.slug | e }}/hats">
    <label>Responsibility <input name="name" required maxlength="120" placeholder="Security review"></label>
    <label>Purpose <textarea name="purpose" required rows="3" placeholder="Review the security of this repository"></textarea></label>
    <label>Short role summary <input name="short_summary" required maxlength="160" placeholder="Reviews security risks in this repository"></label>
    <p class="form-hint">The short summary appears in every conversation's hat directory, including authorized Work. Do not put private notes, credentials, or instructions here. The longer purpose stays admin-facing; the identity text is included only when this hat is worn.</p>
    <label><input type="checkbox" name="confirm_bear_audience" value="true" required> I understand every hat and authorized Work can see this short summary.</label>
    <button type="submit">Create hat</button>
  </form>
  <p class="form-hint">Job use and automatic memory sharing start off. Configure permitted surfaces before enabling Job use.</p>
</div>
{% endblock %}
