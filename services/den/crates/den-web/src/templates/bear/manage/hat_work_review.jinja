{% extends "bear/_manage.html" %}
{% block title %}Review hat memory for Work · {{ bear.slug }}{% endblock %}
{% block manage %}
<p><a href="/bear/{{ bear.slug | e }}/hats/{{ hat.id }}">← {{ hat.name | e }}</a></p>
<div class="box">
  <h2>Before this hat may do autonomous Work</h2>
  <p>Enabling Work changes the audience for this hat's identity text and existing reviewed memory. Future authorized Jobs wearing it may read both while processing untrusted workspace content. A sandbox does not hide knowledge already given to that run's model. This review does not assess Bear-wide <code>core/</code> memory.</p>
  <p>Review the hat identity below and <strong>all {{ snapshot.total_records }}</strong> historical hat record{% if snapshot.total_records != 1 %}s{% endif %}, including superseded or archived entries. If an entry is unsuitable, do not enable Work; have it corrected or archived through curation and restart at page 1.</p>
  {% if hat.work_enabled %}<p><strong>Work is already enabled.</strong> New promotions to this hat require an explicit Work-audience review.</p>{% endif %}
  <p><strong>Page {{ snapshot.page }} of {{ snapshot.page_count }}</strong> — review each page in order. Den fingerprints the entire history for each page while showing only this page's records. If memory changes between pages, restart at page 1. Only the final page offers the Work decision.</p>
  {% if snapshot.total_records == 0 %}<p>This hat has no historical memory. Use the empty-hat Work control on the hat page instead.</p>{% endif %}
</div>
<div class="box"><h3>Hat identity shared with Work</h3><pre>{{ identity_preview | e }}</pre></div>
{% for record in snapshot.records %}
<div class="box">
  <details>
    <summary><code>{{ record.kind | e }}</code> · #{{ record.sequence_no }} · {{ record.created_at | e }}{% if record.invalid_at %} · superseded/invalidated{% endif %}</summary>
    <p><a href="/bear/{{ bear.slug | e }}/memory/records/{{ record.memory_id | urlencode }}">Inspect canonical record</a> · visibility {{ record.visibility | e }}</p>
    <pre>{{ record.content_text | e }}</pre>
    <p class="form-hint">Metadata: <code>{{ record.metadata_json | e }}</code></p>
  </details>
</div>
{% endfor %}
{% if snapshot.complete and snapshot.page > 1 %}
<p><a href="?page={{ snapshot.page - 1 }}&expected_sha256={{ snapshot.sha256 | urlencode }}&expected_identity_sha256={{ snapshot.identity_sha256 | urlencode }}">← Previous review page</a></p>
{% endif %}
{% if snapshot.complete and snapshot.page < snapshot.page_count %}
<div class="box">
  <form method="get" action="/bear/{{ bear.slug | e }}/hats/{{ hat.id }}/work-review">
    <input type="hidden" name="page" value="{{ snapshot.page + 1 }}">
    <input type="hidden" name="expected_sha256" value="{{ snapshot.sha256 | e }}">
    <input type="hidden" name="expected_identity_sha256" value="{{ snapshot.identity_sha256 | e }}">
    <label><input type="checkbox" required> I inspected the records on page {{ snapshot.page }} for the autonomous Work audience.</label>
    <button type="submit">Continue to page {{ snapshot.page + 1 }}</button>
  </form>
</div>
{% endif %}
{% if snapshot.complete and snapshot.total_records > 0 and snapshot.page == snapshot.page_count and not hat.work_enabled %}
<div class="box">
  <h3>Record the review decision</h3>
  <form method="post" action="/bear/{{ bear.slug | e }}/hats/{{ hat.id }}/work-review">
    <input type="hidden" name="expected_sha256" value="{{ snapshot.sha256 | e }}">
    <input type="hidden" name="expected_record_count" value="{{ snapshot.total_records }}">
    <input type="hidden" name="expected_identity_sha256" value="{{ snapshot.identity_sha256 | e }}">
    <label>What did you check about the hat's identity, memory, and Work audience? <textarea name="rationale" required rows="4" maxlength="4000"></textarea></label>
    <label><input type="checkbox" name="confirm_work_audience" value="true" required> I reviewed this hat's identity and every page of memory for autonomous Work, including the risks of untrusted workspace content, tool actions, and egress.</label>
    <button type="submit">Record review and enable Work</button>
  </form>
  <p class="form-hint">If a record changes while you review it, Den rejects this decision and asks you to inspect the new snapshot. Each later Work run still needs its own authorized Job and surfaces.</p>
</div>
{% endif %}
{% endblock %}
