{% extends "bear/_manage.html" %}
{% block title %}{{ hat.name }} · Hats{% endblock %}
{% block manage %}
<p><a href="/bear/{{ bear.slug | e }}/hats">← All hats</a></p>
<div class="box">
  <h2>{{ hat.name | e }}</h2>
  {% if message %}<p role="status">{{ message | e }}</p>{% endif %}
  <form method="post" action="/bear/{{ bear.slug | e }}/hats/{{ hat.id }}">
    <label>Responsibility <input name="name" value="{{ hat.name | e }}" required maxlength="120"></label>
    <label>Purpose <textarea name="purpose" required rows="3">{{ hat.purpose | e }}</textarea></label>
    <label>Hat identity text <textarea name="identity_prompt" required rows="5" maxlength="4000">{{ hat.identity_prompt | e }}</textarea></label>
    <p class="form-hint">Used only while wearing this hat, on future turns. Identity text grants no tools, credentials, or permissions.</p>
    {% if hat.work_enabled %}<label><input type="checkbox" name="confirm_work_audience" value="true" required> I understand future approved autonomous Work will also receive this hat identity text.</label>{% endif %}
    <button type="submit">Save hat description and identity</button>
  </form>
  <form method="post" action="/bear/{{ bear.slug | e }}/hats/{{ hat.id }}/summary">
    <label>Short role summary <input name="short_summary" maxlength="160" value="{{ (hat.short_summary or '') | e }}" placeholder="Describe this role in one sentence"></label>
    <p class="form-hint">Visible to every hat's conversations and authorized Work. Keep private context out; leave blank to remove it. A summary grants no authority.</p>
    <label><input type="checkbox" name="confirm_bear_audience" value="true" required> I understand every hat and authorized Work can see this short summary.</label>
    <button type="submit">Save short summary</button>
  </form>
  <details><summary>Preview compiled hat identity and directory</summary><pre>{{ identity_preview | e }}</pre></details>
  {% if previous_instructions %}
  <details>
    <summary>Review older stance instructions before transferring identity</summary>
    <p class="form-hint">These are effective legacy stance sources; hat-bound turns do not select them. Read them for identity or responsibility wording you want to rewrite in this hat. Do not copy tool, approval, or sandbox claims into hat identity: those limits come from verified runtime policy.</p>
    {% for instruction in previous_instructions %}
    <details>
      <summary>{{ instruction.profile | e }} · {{ instruction.source | e }}</summary>
      <pre>{{ instruction.content | e }}</pre>
    </details>
    {% endfor %}
  </details>
  {% endif %}

  <p><strong>IDE default for this Bear:</strong> {% if ide_default_hat_name %}{{ ide_default_hat_name | e }}{% else %}None selected{% endif %}</p>
  {% if not is_ide_default %}<form method="post" action="/bear/{{ bear.slug | e }}/hats/{{ hat.id }}/ide-default"><button type="submit">Make IDE default</button></form>{% endif %}
  <p class="form-hint">Applies to new editor conversations only. Choose another hat with /hat before the first interaction; existing conversations and Jobs stay bound.</p>
  <form method="post" action="/bear/{{ bear.slug | e }}/hats/{{ hat.id }}/conversations">
    <button type="submit">Start a conversation wearing this hat</button>
  </form>
  <p class="form-hint">Notes from that conversation stay there unless Curate publishes a newly written fact to this hat. Shared hat knowledge is available to future conversations and eligible Job runs wearing it.</p>
  <p><a href="/bear/{{ bear.slug | e }}/hats/{{ hat.id }}/review">Review private notes for this hat →</a></p>
  <p><a href="/bear/{{ bear.slug | e }}/hats/{{ hat.id }}/legacy-review">Inspect and reauthor unattributed legacy notes →</a></p>
  <p><a href="/bear/{{ bear.slug | e }}/hats/{{ hat.id }}/core-review">Review this hat's knowledge for Bear-wide core →</a></p>
</div>
<div class="box">
  <h3>Primary model</h3>
  {% if model_error %}<p class="form-errors">{{ model_error | e }}</p>{% endif %}
  <p>{{ effective_model.source_label | e }}: {% if effective_model.name %}<strong>{{ effective_model.name | e }}</strong> · {% endif %}<code>{{ effective_model.model_handle | e }}</code> · reasoning {{ effective_model.effort_label | e }} · <strong>{{ effective_model.status | e }}</strong></p>
  {% if effective_model.status_detail %}<p class="form-errors">{{ effective_model.status_detail | e }}</p>{% endif %}
  <form method="post" action="/bear/{{ bear.slug | e }}/hats/{{ hat.id }}/model">
    <label for="hat-model-configuration">Model configuration</label>
    <select id="hat-model-configuration" name="configuration_id">
      <option value=""{% if not model_selection %} selected{% endif %}>Inherit Bear default (or deployment default)</option>
      {% for view in configurations %}
      <option value="{{ view.configuration.id }}"{% if model_selection == view.configuration.id | string %} selected{% endif %}{% if view.status == 'unavailable' %} disabled{% endif %}>{{ view.configuration.name | e }} · {{ view.configuration.model_handle | e }} · {{ view.effort_label | e }} · {{ view.status | e }}</option>
      {% endfor %}
    </select>
    <button type="submit">Save primary model</button>
  </form>
  <p class="form-hint">Overrides the whole primary configuration, including reasoning effort. A conversation model pin replaces this choice. This does not change identity or grants.</p>
  <p><a href="/bear/{{ bear.slug | e }}/models">Manage named configurations →</a></p>
</div>
<div class="box" id="hat-resources">
  <h3>What this hat can use</h3>
  <p class="form-hint">Choose from repositories already assigned to this Bear. Separate person and Job permissions still apply. Removing a repository also removes this hat's Work eligibility for existing runs.</p>
  {% if hat.work_enabled %}<p>To add repositories, <a href="#work">disable Work</a> first, then review this hat again.</p>{% endif %}
  {% if choices %}
  <form method="post" action="/bear/{{ bear.slug | e }}/hats/{{ hat.id }}/surfaces">
    {% for surface in choices %}
    <label><input type="checkbox" name="surface_ids" value="{{ surface.id }}"{% if surface.selected %} checked{% endif %}> {{ surface.name | e }}{% if surface.description %} — {{ surface.description | e }}{% endif %}</label>
    {% endfor %}
    <button type="submit">Save permitted repositories</button>
  </form>
  {% else %}<p>No repositories are assigned to this Bear yet. <a href="/bear/{{ bear.slug | e }}/resources">Open What it can use</a> to assign one, then return here to permit it.</p>{% endif %}
</div>
<div class="box">
  <h3>Den web tool and host policy</h3>
  <p class="form-hint">Fetching requires both the web-fetch tool and an exact HTTPS host grant. These grants are shared by future conversations and eligible Jobs wearing this hat, subject to their separate policies; they do not start a Job or supply credentials.</p>
  <p class="form-hint">Revoking web access requests cancellation on the next Work worker poll. Existing relays may remain reachable until provider teardown succeeds. For immediate isolation, <a href="/bear/{{ bear.slug | e }}/jobs">stop the run</a> and have an operator check provider health.</p>
  <details><summary>Help: how access is enforced</summary><p>Den checks the current human and conversation owner, hat grants, block rules, and public DNS. Editor web-fetch approvals can be reused only with both tool and exact-host grants; older Bear-wide approvals do not carry into this hat. Persistent editor grants require a Bear admin; one-time approval remains separate.</p><p>Eligible Job sandboxes intersect hat hosts with repository hosts. The provider must support per-run network ceilings; an old or unreachable provider blocks hat-bound Work. Revocation retries provider teardown after failure. These grants cannot enable disconnected local editor tools or authorize a Job.</p></details>
  {% if web_grants.fetch_tool_grant_id %}
  <p>Web-fetch tool: granted</p>
  <form method="post" action="/bear/{{ bear.slug | e }}/hats/{{ hat.id }}/access">
    <input type="hidden" name="grant_id" value="{{ web_grants.fetch_tool_grant_id }}">
    <button type="submit" name="action" value="revoke">Revoke web-fetch tool grant</button>
  </form>
  {% else %}
  <p>Web-fetch tool: not granted</p>
  <form method="post" action="/bear/{{ bear.slug | e }}/hats/{{ hat.id }}/access">
    <label><input type="checkbox" name="confirm_future_job_audience" value="true" required> I understand this is shared with future conversations and eligible Job runs wearing this hat, once their separate execution and network policies permit it.</label>
    <button type="submit" name="action" value="enable_fetch">Grant web-fetch tool to this hat</button>
  </form>
  {% endif %}
  <p class="form-hint">Search sends queries to an external provider using its server-side key, with privacy, network, and usage costs. It requires its own tool grant and the exact provider host <code>api.search.brave.com</code>. It does not inherit web-fetch permission or grant other providers access.</p>
  {% if web_grants.search_tool_grant_id %}
  <p>Web-search tool: granted</p>
  <form method="post" action="/bear/{{ bear.slug | e }}/hats/{{ hat.id }}/access">
    <input type="hidden" name="grant_id" value="{{ web_grants.search_tool_grant_id }}">
    <button type="submit" name="action" value="revoke">Revoke web-search tool grant</button>
  </form>
  {% else %}
  <p>Web-search tool: not granted</p>
  <form method="post" action="/bear/{{ bear.slug | e }}/hats/{{ hat.id }}/access">
    <label><input type="checkbox" name="confirm_future_job_audience" value="true" required> I understand search queries may be sent to the configured provider using its server-side key, with usage costs, and this grant is shared with future conversations and eligible Job runs wearing this hat once their separate policies allow it.</label>
    <button type="submit" name="action" value="enable_search">Grant web-search tool to this hat</button>
  </form>
  {% endif %}
  <h4>Exact HTTPS hosts</h4>
  {% if web_grants.hosts %}
  <ul>{% for grant in web_grants.hosts %}
    <li>{{ grant.host | e }}
      <form method="post" action="/bear/{{ bear.slug | e }}/hats/{{ hat.id }}/access">
        <input type="hidden" name="grant_id" value="{{ grant.id }}">
        <button type="submit" name="action" value="revoke">Revoke {{ grant.host | e }}</button>
      </form>
    </li>
  {% endfor %}</ul>
  {% else %}<p>No HTTPS hosts granted.</p>{% endif %}
  <form method="post" action="/bear/{{ bear.slug | e }}/hats/{{ hat.id }}/access">
    <label>Exact HTTPS host <input name="host" placeholder="docs.example.com" required></label>
    <p class="form-hint">No wildcards, IP addresses, custom ports, HTTP, site accounts, or URL patterns. A host grant does not imply a tool grant.</p>
    <label><input type="checkbox" name="confirm_future_job_audience" value="true" required> I understand future conversations and eligible Job runs wearing this hat may use this host where their separate execution and work-surface policies allow it.</label>
    <button type="submit" name="action" value="allow_host">Grant HTTPS host</button>
  </form>
</div>
<div class="box">
  <h3>Editor workspace read permissions</h3>
  <p class="form-hint">Only the selected read action in this exact editor workspace. Every authorized member's future editor conversations wearing this hat may reuse it. It grants no writes, terminal, credentials, web access, or Job access; Work cannot use it today.</p>
  <details><summary>Help: how workspace access is enforced</summary><p>Den rechecks membership, conversation ownership, hat, and grant on each use. The connected editor also enforces the live workspace boundary and sensitive-file rules. A saved permission does not override local filesystem policy or match another root.</p></details>
  {% if workspace_read_grants %}
  <ul>{% for grant in workspace_read_grants %}
    <li>{{ grant.title | e }} in <code>{{ grant.workspace_root | e }}</code>
      <form method="post" action="/bear/{{ bear.slug | e }}/hats/{{ hat.id }}/access">
        <input type="hidden" name="grant_id" value="{{ grant.id }}">
        <button type="submit" name="action" value="revoke_workspace">Revoke this workspace read permission</button>
      </form>
    </li>
  {% endfor %}</ul>
  {% else %}<p>No editor workspace read permissions granted.</p>{% endif %}
  <form method="post" action="/bear/{{ bear.slug | e }}/hats/{{ hat.id }}/access">
    <label>Read-only action <select name="tool_name" required>
      {% for choice in workspace_read_choices %}<option value="{{ choice.provider_name | e }}">{{ choice.title | e }}</option>{% endfor %}
    </select></label>
    <label>Exact editor workspace root <input name="workspace_root" placeholder="/workspace/project" required maxlength="2000" autocomplete="off"></label>
    <p class="form-hint">Use the editor's absolute, normalized root. No <code>..</code>, wildcards, home shortcut, or trailing slash.</p>
    <label><input type="checkbox" name="confirm_future_job_audience" value="true" required> I understand every authorized member's future editor conversations wearing this hat can reuse it, and eligible Jobs may become readers only if Den later authorizes a separate connected, bounded Work armature.</label>
    <button type="submit" name="action" value="grant_workspace_read">Grant workspace read action</button>
  </form>
</div>
<div class="box" id="repository-head">
  <h3>Read repository head</h3>
  <p role="status"><strong>External credential backend not integrated — repository_head is unavailable.</strong> You may prepare an exact permission below; saving it does not configure a backend, supply credentials or start Work.</p>
  <p>Only the configured GitHub branch SHA is readable. Bear assignment, this hat's permitted repositories, the exact action, <code>api.github.com</code> host permission and repository egress ceiling, current source and your separately owned Connection must all allow it. Another wearer cannot borrow your account.</p>
  {% for grant in repository_grants %}
    <form method="post" action="/bear/{{ bear.slug | e }}/hats/{{ hat.id }}/repository-access">
      <p>Saved exact scope <code>{{ grant.target_key | e }}</code>. Changing the repository, branch, account or credential version invalidates this permission.</p>
      <input type="hidden" name="grant_id" value="{{ grant.id }}"><button name="action" value="revoke">Revoke repository-head permission</button>
    </form>
  {% else %}<p>No repository-head permissions saved.</p>{% endfor %}
  {% for repository in repository_choices %}
    <form method="post" action="/bear/{{ bear.slug | e }}/hats/{{ hat.id }}/repository-access">
      <p><strong>{{ repository.name | e }}</strong> — {{ repository.owner | e }}/{{ repository.repository | e }}, configured branch <code>{{ repository.branch | e }}</code></p>
      <input type="hidden" name="surface_id" value="{{ repository.surface_id }}">
      <input type="hidden" name="expected_target" value="{{ repository.target_key | e }}">
      <label><input type="checkbox" name="confirm_future_job_audience" value="true" required>I approve this exact repository/branch/account binding for future owned conversations and separately eligible Jobs wearing this hat. Other humans cannot use my Connection; backend and host access remain separate.</label>
      <button name="action" value="grant">Save exact repository-head permission</button>
    </form>
  {% else %}<p>No eligible repository with an external-reference account you own. Use Connections to save an inactive reference, attach it only to an idle repository, then assign the repository to this Bear and permit it for this hat. Legacy encrypted/App credentials do not qualify.</p>{% endfor %}
</div>
<div class="box" id="sharing">
  <h3>Automatic memory sharing for this hat: {{ hat.auto_curate_enabled and "on" or "off" }}</h3>
  <p>Private notes may be sent to this Bear's configured model provider, with privacy, network, and usage costs. Rewritten knowledge is shared with all members and eligible Jobs wearing this hat, now and in the future. Rewriting cannot guarantee removal of sensitive details or prompt injections.</p>
  <p class="form-hint">Disabling automatic sharing stops future automatic publication; it does not withdraw knowledge already shared.</p>
  <details><summary>Help: how automatic sharing works</summary><p>Curate writes a new fact rather than publishing the source note verbatim. Shared knowledge remains untrusted data and grants no tools, credentials, permissions, or Job authority.</p></details>
  {% if hat.auto_curate_enabled %}
  <form method="post" action="/bear/{{ bear.slug | e }}/hats/{{ hat.id }}/auto-curate"><button type="submit" name="action" value="disable">Disable automatic sharing</button></form>
  {% else %}
  <form method="post" action="/bear/{{ bear.slug | e }}/hats/{{ hat.id }}/auto-curate">
    <label><input type="checkbox" name="confirm_audience" value="true" required> I understand private notes may be sent to the configured model, and rewritten knowledge becomes available to every member and authorized Job run wearing this hat.</label>
    <button type="submit" name="action" value="enable">Enable automatic sharing</button>
  </form>
  {% endif %}
</div>
<div class="box" id="work">
  <h3>Use in Jobs: {{ hat.work_enabled and "on" or "off" }}</h3>
  <p>Eligible Jobs wearing this hat may read its identity and shared knowledge, including facts learned later. Enabling Work does not start a run or grant tools, credentials, or access; each run needs its own authorization and permitted repositories.</p>
  <details><summary>Help: when Work memory is reviewed</summary><p>Enablement reviews the hat's entire historical memory and current identity. It is not a review before every run or each later fact.</p></details>
  {% if grant_count == 0 %}<p class="form-errors" role="status"><strong>Work is blocked: no repositories are permitted.</strong> {% if hat.work_enabled %}Disable Job use below before adding repositories, then review and enable Work again. {% endif %}{% if choices %}<a href="#hat-resources">Select and save a permitted repository above</a>.{% else %}<a href="/bear/{{ bear.slug | e }}/resources">Assign a repository to this Bear</a>, then <a href="#hat-resources">permit it for this hat</a>.{% endif %}</p>{% endif %}
  {% if hat.work_enabled %}
  <form method="post" action="/bear/{{ bear.slug | e }}/hats/{{ hat.id }}/work"><button type="submit" name="action" value="disable">Disable Job use</button></form>
  {% else %}
  <form method="post" action="/bear/{{ bear.slug | e }}/hats/{{ hat.id }}/work">
    <input type="hidden" name="expected_identity_sha256" value="{{ identity_sha256 | e }}">
    <label><input type="checkbox" name="confirm_identity_audience" value="true" required> I reviewed the identity text above for autonomous Work in an untrusted workspace.</label>
    <label>Type <code>enable work</code> to confirm <input name="confirmation" autocomplete="off" required></label>
    <button type="submit" name="action" value="enable"{% if grant_count == 0 or historical_hat_records > 0 %} disabled{% endif %}>Enable Work for an empty hat</button>
  </form>
  {% endif %}
  {% if historical_hat_records > 0 and not hat.work_enabled %}<p><a href="/bear/{{ bear.slug | e }}/hats/{{ hat.id }}/work-review">Review {{ historical_hat_records }} historical hat record{% if historical_hat_records != 1 %}s{% endif %} before enabling Work →</a></p>{% endif %}
  {% if work_reviews %}
  <details><summary>Past Work memory reviews ({{ work_reviews | length }})</summary>
    <ul>{% for review in work_reviews %}
      <li>{{ review.reviewed_at | e }} · {{ review.reviewed_by | e }} reviewed {{ review.record_count }} record{% if review.record_count != 1 %}s{% endif %}: {{ review.rationale | e }} <code>{{ review.id }}</code>{% if review.identity_sha256 %} · identity fingerprint <code>{{ review.identity_sha256 | e }}</code>{% endif %}</li>
    {% endfor %}</ul>
  </details>
  {% endif %}
</div>
{% endblock %}
