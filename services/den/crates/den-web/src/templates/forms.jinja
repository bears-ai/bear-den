{# `errors` may be supplied globally or in the form-data map. #}
{% macro input(name, label, type, extra_attrs, form_data, hint, appendix) %}
  {% if errors is undefined and form_data is defined %}{% set errors = form_data.errors %}{% endif %}
  {% set value_attr = 'value="' ~ form_data[name]|e ~ '" ' if type != 'password' and type != 'checkbox' and form_data is defined and form_data and form_data[name] is defined %}
  <label for="{{name}}_input" {{ 'class="has-error"' if errors and errors[name] }}>{{label}}</label>
  <div class="form-field{{ ' has-error' if errors and errors[name] }}">
    <input id="{{name}}_input" name="{{name}}" type="{{ type or 'text'}}" {% if errors and errors[name] %}aria-invalid="true" aria-describedby="{{name}}_error" {% endif %}{{value_attr | safe}}{{extra_attrs | safe}}>
    {% if appendix is defined %}<label for="{{name}}_input">{{appendix | safe}}</label>{% endif %}
    {% if errors and errors[name] %}
    <span id="{{name}}_error" class="form-hint form-errors" role="alert">{{ errors[name] | map(attribute="message", default="Check this field.") | join(", ") }}</span>
    {% endif %}
    {% if hint is defined %}<span class="form-hint">{{ hint | safe }}</span>{% endif %}
  </div>
{% endmacro %}

{% macro select(name, label, options, extra_attrs, form_data, hint, appendix) %}
  {% if errors is undefined and form_data is defined %}{% set errors = form_data.errors %}{% endif %}
  {% set selected_key = form_data[name] if form_data is defined and form_data %}
  <label for="{{name}}_select" {{ 'class="has-error"' if errors and errors[name] }}>{{label}}</label>
  <div class="form-field{{ ' has-error' if errors and errors[name] }}">
    <select id="{{name}}_select" name="{{name}}" {% if errors and errors[name] %}aria-invalid="true" aria-describedby="{{name}}_error" {% endif %}{{extra_attrs | safe}}>
    {% for value, label in options|items %}
      <option value="{{ value }}"{{ ' selected' if value == selected_key }}>{{ label }}</option>
    {% endfor %}
    </select>
    {% if appendix is defined %}<label for="{{name}}_select">{{appendix | safe}}</label>{% endif %}
    {% if errors and errors[name] %}
    <span id="{{name}}_error" class="form-hint form-errors" role="alert">{{ errors[name] | map(attribute="message", default="Check this field.") | join(", ") }}</span>
    {% endif %}
    {% if hint is defined %}<span class="form-hint">{{ hint | safe }}</span>{% endif %}
  </div>
{% endmacro %}

{% macro textarea(name, label, extra_attrs, form_data, hint, appendix) %}
  {% if errors is undefined and form_data is defined %}{% set errors = form_data.errors %}{% endif %}
  {% set value = form_data[name] if form_data is defined and form_data %}
  <label for="{{name}}_textarea" {{ 'class="has-error"' if errors and errors[name] }}>{{label}}</label>
  <div class="form-field{{ ' has-error' if errors and errors[name] }}">
    <textarea id="{{name}}_textarea" name="{{name}}" {% if errors and errors[name] %}aria-invalid="true" aria-describedby="{{name}}_error" {% endif %}{{extra_attrs | safe}}>{{ value | e if value }}</textarea>
    {% if appendix is defined %}<label for="{{name}}_textarea">{{appendix | safe}}</label>{% endif %}
    {% if errors and errors[name] %}
    <span id="{{name}}_error" class="form-hint form-errors" role="alert">{{ errors[name] | map(attribute="message", default="Check this field.") | join(", ") }}</span>
    {% endif %}
    {% if hint is defined %}<span class="form-hint">{{ hint | safe }}</span>{% endif %}
  </div>
{% endmacro %}
