  "query": "\n        SELECT receipt_id AS \"receipt_id!: String\", recorded_bear_id, actor_user_id AS \"actor_user_id!: i32\",\n               previous_user_id AS \"previous_user_id!: i32\", entity_id,\n               destination_user_id AS \"destination_user_id?: i32\", displaced_entity_id,\n               prior_generation AS \"prior_generation!: i64\",\n               resulting_generation AS \"resulting_generation!: i64\", recorded_at\n        FROM user_identity_receipts WHERE bear_id = ?\n        ORDER BY recorded_at DESC, receipt_id DESC LIMIT ?\n        ",
