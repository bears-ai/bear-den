  "query": "SELECT r.id, r.record_count, r.rationale, r.reviewed_at, u.username AS \"reviewed_by!\"\n         FROM bear_hat_work_reviews r JOIN users u ON u.id = r.reviewed_by_user_id\n         WHERE r.bear_id = $1 AND r.hat_id = $2 ORDER BY r.reviewed_at DESC LIMIT 20",
