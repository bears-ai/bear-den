{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, sequence_no, session_id, event_type, event_json, created_at\n        FROM bearwire_events\n        WHERE bear_id = $1 AND user_id = $2 AND session_id = $3\n          AND ($4::bigint IS NULL OR sequence_no > $4)\n        ORDER BY sequence_no ASC\n        LIMIT $5\n        ",
