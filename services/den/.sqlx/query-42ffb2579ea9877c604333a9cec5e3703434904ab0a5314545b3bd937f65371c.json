  "query": "SELECT j.created_by_user_id,j.visibility,COALESCE(lower(btrim(ub.role))='admin',false) AS \"admin!\",a.cabinet_ref AS \"cabinet_ref?\",COALESCE(a.revision,0) AS \"revision!\" FROM bear_jobs j JOIN user_bear ub ON ub.bear_id=j.bear_id AND ub.user_id=$3 LEFT JOIN job_cabinet_refs a ON a.job_id=j.id WHERE j.id=$1 AND j.bear_id=$2",
